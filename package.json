{
  "name": "accesibilidad-web-practica",
  "version": "1.0.0",
  "private": true,
  "description": "Curso práctico de accesibilidad web y WCAG 2.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run build:frameworks",
    "prestart": "npm run build:frameworks",
    "build:frameworks": "node scripts/compilar-frameworks.mjs",
    "dev:frameworks": "node scripts/compilar-frameworks.mjs --watch",
    "start": "node scripts/servidor.mjs",
    "check": "node scripts/comprobar.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "3.5.44",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
